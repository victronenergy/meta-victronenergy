#!/bin/sh
### BEGIN INIT INFO
# Provides:          venus-mdns-aliases
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: static mdns name
### END INIT INFO

DAEMON=/usr/sbin/venus-mdns-aliases
NAME=venus-mdns-aliases
PIDFILE=/var/run/$NAME.pid

case "$1" in
    start)
        echo "Starting $NAME..."
        start-stop-daemon --start \
            --background \
            --make-pidfile \
            --pidfile "$PIDFILE" \
            --exec "$DAEMON"
        ;;
    stop)
        echo "Stopping $NAME..."
        start-stop-daemon --stop \
            --pidfile "$PIDFILE" \
            --retry=TERM/30/KILL/5
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    status)
        if start-stop-daemon --status --pidfile "$PIDFILE"; then
            echo "$NAME is running"
        else
            echo "$NAME is not running"
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit 0

