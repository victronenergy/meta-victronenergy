#!/bin/sh

# The CAN-bus interfaces
interfaces=$(ip -o link show type can | awk -F': ' '{print $2}' | tr '\n' ',' | sed -e 's/,$//')
if [ "$interfaces" = "" ]; then
	svc -d .
	exit 1
fi

# If a network is not connected, binding will fail. Lets not hog the
# cpu and simply add a delay here.
def_interface=$(route | grep '^default' | grep -o '[^ ]*$')
while [ "$def_interface" = "" ]; do
	sleep 60
	def_interface=$(route | grep '^default' | grep -o '[^ ]*$')
done

# exec, not fork+loop -- daemontools supervises this script's own PID;
# without exec, socketcand runs as an unsupervised child one level
# removed from what `svc -d`/`svc -t` actually signals, so stopping the
# service orphans the real daemon instead of stopping it (ec-socketcand
# queue/W14). supervise's own respawn (on exit) replaces the old
# hand-rolled while-loop.
exec socketcand -i $interfaces -l $def_interface -v
